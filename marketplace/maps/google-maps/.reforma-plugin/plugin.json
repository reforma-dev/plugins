{
    "name": "google-maps",
    "description": "Maps in the app — places, routes, and what’s nearby",
    "logo": "assets/logo.svg",
    "author": {
        "name": "Google",
        "url": "https://developers.google.com/maps"
    },
    "homepage": "https://developers.google.com/maps/ai/grounding-lite",
    "interface": {
        "displayName": "Google Maps",
        "brandColor": "#FFFFFF",
        "logo": "assets/logo.svg"
    },
    "mcpServers": "./mcp.json",
    "variables": {
        "type": "object",
        "properties": {
            "API_KEY": {
                "type": "string",
                "title": "API key",
                "description": "Google Cloud API key with Maps Grounding Lite turned on",
                "placeholder": "AIza…"
            }
        },
        "required": [
            "API_KEY"
        ]
    }
}
