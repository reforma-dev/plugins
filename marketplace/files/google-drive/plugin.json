{
    "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
    "name": "google-drive",
    "description": "Docs and files in Google Drive — find them, upload drafts, share from the project",
    "extensions": {
        "reforma": {
            "logo": "assets/logo.svg",
            "mcpServers": "./mcp.json",
            "interface": {
                "displayName": "Google Drive",
                "brandColor": "#FFFFFF"
            },
            "agent": {
                "mentions": [
                    "drive.google.com"
                ]
            }
        }
    }
}
