{
    "name": "21st",
    "description": "Search and install UI from the 21st catalog. Needs an API key.",
    "logo": "assets/logo.svg",
    "author": {
        "name": "21st",
        "url": "https://21st.dev"
    },
    "homepage": "https://21st.dev/mcp",
    "interface": {
        "displayName": "21st",
        "brandColor": "#0A0A0A"
    },
    "mcpServers": "./mcp.json",
