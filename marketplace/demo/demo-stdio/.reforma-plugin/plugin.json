{
    "name": "demo-stdio",
    "description": "Stdio MCP: command/args stay as written. Variables substitute into env at connect.",
    "logo": "assets/logo.svg",
    "interface": {
        "brandColor": "#F59E0B"
    },
    "variables": {
        "type": "object",
        "properties": {
            "TOKEN": {
                "type": "string",
                "title": "Token",
                "description": "Stamped as DEMO_STDIO_TOKEN on the process. Not added to args.",
                "placeholder": "demo-…"
            },
            "REGION": {
                "type": "string",
                "title": "Region",
                "description": "Non-secret. Stamped as DEMO_STDIO_REGION at connect.",
                "placeholder": "us-east-1",
                "secret": false
            },
            "INCLUDE_CODE": {
                "type": "boolean",
                "title": "Include code snippets",
                "default": true
            },
            "TOPIC": {
                "type": "string",
                "title": "Topic",
                "default": "auto",
                "enum": ["auto", "api", "guide"]
            }
        },
        "required": ["TOKEN"]
    }
}
