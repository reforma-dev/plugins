{
    "name": "demo-kit",
    "description": "Sample plugin to try the catalog — skills, tools, hooks, and a server.",
    "logo": "assets/logo.svg",
    "interface": {
        "brandColor": "#6366F1"
    },
    "variables": {
        "type": "object",
        "properties": {
            "TOKEN": {
                "type": "string",
                "title": "Token",
                "description": "Stamped as DEMO_KIT_TOKEN on the MCP process.",
                "placeholder": "kit-…"
            },
            "REGION": {
                "type": "string",
                "title": "Region",
                "description": "Non-secret. Stamped as DEMO_KIT_REGION.",
                "placeholder": "us-east-1",
                "secret": false,
                "default": "us-east-1"
            }
        },
        "required": ["TOKEN"]
    }
}
