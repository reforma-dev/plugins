{
    "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
    "name": "github",
    "description": "GitHub in the project — issues, pull requests, and the repo",
    "author": {
        "name": "GitHub",
        "url": "https://github.com"
    },
    "extensions": {
        "reforma": {
            "logo": "assets/logo.svg",
            "mcpServers": "./mcp.json",
            "interface": {
                "displayName": "GitHub",
                "brandColor": "#FFFFFF",
                "logo": "assets/logo.svg",
                "logoSmall": "assets/logo-small.svg"
            },
            "logoSmall": "assets/logo-small.svg",
            "agent": {
                "mentions": [
                    "github.com"
                ]
            }
        }
    }
}
