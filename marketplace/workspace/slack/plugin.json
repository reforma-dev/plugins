    "name": "slack",
    "description": "The team’s Slack — channels, threads, and posts from the project",
    "author": {
        "name": "Slack",
        "url": "https://slack.com"
    },
    "extensions": {
        "reforma": {
            "logo": "assets/logo.svg",
            "mcpServers": "./mcp.json",
            "interface": {
